diff --git a/libs/vkd3d/device_workarounds.c b/libs/vkd3d/device_workarounds.c
index bfe7a47..8d59b87 100644
--- a/libs/vkd3d/device_workarounds.c
+++ b/libs/vkd3d/device_workarounds.c
@@ -1037,4 +1037,12 @@ void vkd3d_physical_device_info_apply_workarounds(struct vkd3d_physical_device_i
         struct d3d12_device *device)
 {
+    if (d3d12_device_uses_borealis_queue_policy(device))
+    {
+        /* Keep explicit attachment and shader-read layouts on Borealis. This
+         * only changes GPUs on which the driver exposes unified layouts. */
+        info->unified_image_layouts_features.unifiedImageLayouts = VK_FALSE;
+        info->unified_image_layouts_features.unifiedImageLayoutsVideo = VK_FALSE;
+    }
+
     /* A performance workaround for NV.
      * The 16 byte offset is a lie, as that is only actually required when we
@@ -1182,4 +1190,17 @@ bool vkd3d_application_attempts_complex_multiview(void)
 VKD3D_DEBUG_CONTROL_BEHAVIOR_FLAGS vkd3d_debug_control_get_behavior_flags(void);
 
+bool d3d12_device_uses_borealis_queue_policy(const struct d3d12_device *device)
+{
+    /* Borealis reports this driver name on every Apple GPU it drives. No GPU
+     * generation is excluded: every Apple GPU is a tiler, the single queue
+     * only changes devices that expose more than one queue, and the layout
+     * change only applies where the driver exposes unified image layouts.
+     * The driver ID is not the key, since Borealis reports either
+     * VK_DRIVER_ID_MESA_HONEYKRISP or its own ID depending on its
+     * configuration. */
+    return !VKD3D_CONFIG_FLAG_IS_SET(SKIP_DRIVER_WORKAROUNDS) &&
+            !strcmp(device->device_info.vulkan_1_2_properties.driverName, "Borealis");
+}
+
 void d3d12_device_init_workarounds(struct d3d12_device *device)
 {
@@ -1225,4 +1246,14 @@ void d3d12_device_init_workarounds(struct d3d12_device *device)
     }
 
+    if (d3d12_device_uses_borealis_queue_policy(device))
+    {
+        /* Use render-pass-local barriers instead of suspending rendering
+         * across command lists. Set them under either Borealis driver ID,
+         * since only the Honeykrisp ID enables them above. */
+        device->workarounds.tiler_renderpass_barriers = true;
+        device->workarounds.tiler_suspend_resume = false;
+        INFO("Using the Borealis single queue, render-pass barriers and explicit image layouts.\n");
+    }
+
     /* For testing purposes, allow us to exercise all code paths on all GPUs. */
     if (vkd3d_debug_control_get_behavior_flags() & VKD3D_DEBUG_CONTROL_BEHAVIOR_ENABLE_TILER_SYNC)
