@@ -25572,9 +25572,29 @@ static void d3d12_command_queue_wait_staggered_submission(struct d3d12_command_q
     VkResult vr;
 
+    uint64_t value = command_queue->last_submission_timeline_value;
+
+    if (d3d12_device_uses_borealis_queue_policy(command_queue->device) &&
+            !command_queue->stagger_yields_to_priority)
+    {
+        /* Graphics and non-graphics queues share this Vulkan queue, which
+         * the Borealis single queue guarantees. Keep two chunks from this
+         * logical queue in flight instead of one, so that the GPU does not
+         * go idle while the host waits and submits the next chunk. A queue
+         * that staggers to let a higher-priority queue's work in sooner
+         * keeps one chunk, since that throttling exists for latency. Keep
+         * the history on the logical queue, since values from other queues
+         * may interleave on the Vulkan timeline. */
+        uint64_t previous = command_queue->stagger_previous_value;
+        command_queue->stagger_previous_value = value;
+        if (!previous)
+            return;
+        value = previous;
+    }
+
     memset(&wait_info, 0, sizeof(wait_info));
     wait_info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO;
