+#if defined(__linux__) && defined(__aarch64__) && defined(HAVE_SCHED_YIELD)
+/* Back off after a burst of empty polls within one driver-event check
+ * interval. Sparse polls still yield without requesting a sleep. */
+static __thread unsigned int empty_peeks;
+static __thread LONGLONG empty_peek_tick;
+
+static void yield_empty_peek(void)
+{
+    LONGLONG tick = get_driver_check_time();
+
+    if (tick != empty_peek_tick)
+    {
+        empty_peek_tick = tick;
+        empty_peeks = 0;
+    }
+    if (++empty_peeks >= 8)
+    {
+        const struct timespec delay = { 0, 50000 };
+        empty_peeks = 0;
+        nanosleep( &delay, NULL );
+    }
+    else sched_yield();
+}
+#endif
