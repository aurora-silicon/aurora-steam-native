# Public GE ARM64 Proton CLI, executed under the published userpages 4K launcher.
set -euo pipefail
TOOL=$(dirname -- "$(readlink -f -- "$0")")
for file in proton files/bin-arm64/wine files/bin-arm64/wineserver; do
  [ -f "$TOOL/$file" ] || { echo "Missing native Proton component: $file" >&2; exit 2; }
done
[ -x "$TOOL/files/bin-arm64/wine" ] && [ -x "$TOOL/files/bin-arm64/wineserver" ] || {
  echo 'Native Wine components are not executable' >&2; exit 2;
}
AURORA_USERPAGES_LAUNCHER=${AURORA_USERPAGES_LAUNCHER:-$(command -v userpages || echo /usr/libexec/aurora/userpages)}
# Steam runs this tool inside the Steam Linux Runtime container, where the host's
# /usr is only visible below /run/host. Fall back to the host copy there.
if [ ! -x "$AURORA_USERPAGES_LAUNCHER" ] && [ -x "/run/host$AURORA_USERPAGES_LAUNCHER" ]; then
  AURORA_USERPAGES_LAUNCHER="/run/host$AURORA_USERPAGES_LAUNCHER"
fi
[ -x "$AURORA_USERPAGES_LAUNCHER" ] || { echo "Public userpages launcher missing: $AURORA_USERPAGES_LAUNCHER" >&2; exit 2; }
# GE's public launcher selects these same native binaries for PROTON_USE_ARM64=1.
export PROTON_USE_ARM64=1
export WINESERVER="$TOOL/files/bin-arm64/wineserver"
# Present through Wine's Wayland driver by default. Under XWayland every
# frame takes an extra copy and XWayland's own pacing, which stutters at
# high frame rates, and Wine picks the monitor at the X origin, not the
# primary one. Proton only uses it when WAYLAND_DISPLAY is set; a game opts
# out with PROTON_ENABLE_WAYLAND=0 in its launch options.
export PROTON_ENABLE_WAYLAND=${PROTON_ENABLE_WAYLAND-1}
# GE configures its Wine library directories and native FEX bridges. Keep its
# normal CLI/Steam environment and use the session's public graphics drivers.
exec "$AURORA_USERPAGES_LAUNCHER" 4k /usr/bin/python3 "$TOOL/proton" "$@"
