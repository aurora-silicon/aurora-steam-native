diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index b194188..4f8a384 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -25572,9 +25572,23 @@ static void d3d12_command_queue_wait_staggered_submission(struct d3d12_command_q
     VkResult vr;
 
+    uint64_t value = command_queue->last_submission_timeline_value;
+
+    if (d3d12_device_uses_borealis_g17c_queue_policy(command_queue->device))
+    {
+        /* Let the other queue submit while two chunks from this queue are
+         * in flight. Keep the history on the logical queue, since values
+         * from other queues may interleave on the Vulkan timeline. */
+        uint64_t previous = command_queue->stagger_previous_value;
+        command_queue->stagger_previous_value = value;
+        if (!previous)
+            return;
+        value = previous;
+    }
+
     memset(&wait_info, 0, sizeof(wait_info));
     wait_info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO;
     wait_info.semaphoreCount = 1;
     wait_info.pSemaphores = &command_queue->vkd3d_queue->submission_timeline;
-    wait_info.pValues = &command_queue->last_submission_timeline_value;
+    wait_info.pValues = &value;
 
     if ((vr = VK_CALL(vkWaitSemaphores(command_queue->device->vk_device, &wait_info, UINT64_MAX))))
@@ -25706,4 +25720,5 @@ static void d3d12_command_queue_execute(struct d3d12_command_queue *command_queu
     if (command_queue->stagger_submissions != stagger_submissions)
     {
+        command_queue->stagger_previous_value = 0;
         command_queue->stagger_submissions = stagger_submissions;
         INFO("%sabling staggered submissions for command queue %p, queue family %u.\n",
