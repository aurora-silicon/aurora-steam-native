diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 39e4b0b..fd4153c 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -5943,4 +5943,12 @@ static void d3d12_descriptor_heap_write_null_descriptor_template_embedded(struct
 }
 
+/* A null write clears all sibling sets. Choose a null type legal for each layout. */
+static VkDescriptorType d3d12_compatible_null_type(uint32_t allowed, VkDescriptorType requested)
+{
+    if ((unsigned int)requested < 32 && (allowed & (1u << requested)))
+        return requested;
+    return (VkDescriptorType)vkd3d_bitmask_tzcnt32(allowed);
+}
+
 static void d3d12_descriptor_heap_write_null_descriptor_template(vkd3d_cpu_descriptor_va_t desc_va,
         VkDescriptorType vk_mutable_descriptor_type)
@@ -5989,5 +5997,6 @@ static void d3d12_descriptor_heap_write_null_descriptor_template(vkd3d_cpu_descr
             src = null_descriptor_template->writes.payloads[i].src_payload;
             if (!src)
-                src = vkd3d_bindless_state_get_null_descriptor_payload(bindless_state, vk_mutable_descriptor_type);
+                src = vkd3d_bindless_state_get_null_descriptor_payload(bindless_state,
+                        d3d12_compatible_null_type(null_descriptor_template->mutable_type_masks[i], vk_mutable_descriptor_type));
             memcpy(dst, src, null_descriptor_template->writes.payloads[i].desc_size);
         }
@@ -6001,5 +6010,6 @@ static void d3d12_descriptor_heap_write_null_descriptor_template(vkd3d_cpu_descr
             writes[i] = null_descriptor_template->writes.descriptors.writes[i];
             if (writes[i].descriptorType == VK_DESCRIPTOR_TYPE_MUTABLE_EXT)
-                writes[i].descriptorType = vk_mutable_descriptor_type;
+                writes[i].descriptorType = d3d12_compatible_null_type(
+                        null_descriptor_template->mutable_type_masks[i], vk_mutable_descriptor_type);
             writes[i].dstArrayElement = offset;
         }
@@ -9521,5 +9531,5 @@ static HRESULT d3d12_descriptor_heap_create_descriptor_buffer(struct d3d12_descr
                         &device->bindless_state,
                         set_info->vk_descriptor_type == VK_DESCRIPTOR_TYPE_MUTABLE_EXT ?
-                                VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE : set_info->vk_descriptor_type);
+                                set_info->vk_init_null_descriptor_type : set_info->vk_descriptor_type);
             }
 
@@ -10199,4 +10209,15 @@ static HRESULT d3d12_descriptor_heap_init_legacy(struct d3d12_descriptor_heap *d
                         !d3d12_device_use_embedded_mutable_descriptors(device))
                 {
+                    if (set_info->vk_descriptor_type == VK_DESCRIPTOR_TYPE_MUTABLE_EXT)
+                    {
+                        struct d3d12_null_descriptor_template *tmpl = &descriptor_heap->null_descriptor_template;
+                        VkDescriptorType types[VKD3D_MAX_MUTABLE_DESCRIPTOR_TYPES];
+                        unsigned int count, j;
+
+                        count = vkd3d_bindless_build_mutable_type_list(types, device->bindless_state.flags, set_info->flags);
+                        for (j = 0; j < count; j++)
+                            tmpl->mutable_type_masks[tmpl->num_writes] |= 1u << types[j];
+                    }
+
                     if (d3d12_device_uses_descriptor_buffers(device))
                         d3d12_descriptor_heap_add_null_descriptor_template_buffers(descriptor_heap, set_info, i);
